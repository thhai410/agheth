# Copy to .env and fill in. .env is gitignored — NEVER commit it.
# Secrets also stay out of chat: paste into .env locally, not into any conversation.

# --- LLM (endpoint OpenAI-compatible) -------------------------------------
# Mặc định: DeepSeek V4.1 (extract / assemble / safety grader)
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4.1

# Test trước bằng Gemini (OpenAI-compatible endpoint của Google) — chỉ cần
# đổi 3 dòng trên thành:
#   LLM_API_KEY=<key từ Google AI Studio>
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_MODEL=gemini-3.8-flash
# (model id khác: xem https://aistudio.google.com/docs/openai — danh sách hay đổi)

# Tên cũ (vẫn đọc được — llm_* ở trên được ưu tiên nếu cả hai cùng set):
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4.1

# --- Retrieval (M1+) ------------------------------------------------------
MILVUS_URI=http://localhost:19530
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# DeepSeek Harness runtime (M2+) — bản pin nằm trong lockfile, không phải ở đây
DSH_VERSION=
